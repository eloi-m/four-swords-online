# Docker build context (deploy/*.Dockerfile): source files only. An allowlist, so that disc images, extracted game
# files, Dolphin captures and anything else local never reach the image or the Docker daemon.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!apps
!packages
!tools
!deploy/Caddyfile

**/node_modules
**/dist
**/.vite
**/*.rvz
**/*.iso
**/*.gcm
**/*.nkit.*
**/*.bin
**/*.gba
**/*.sav
**/*.s[0-9][0-9]
**/*.dtm
**/*.gci
