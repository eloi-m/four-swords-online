# Copy to deploy/.env and edit (docs/deploy.md).
# Your domain; its DNS A/AAAA records must point at this machine, with ports 80 and 443 open.
SITE_ADDRESS=fso.example.org
# Optional: Caddy global options, e.g. an email for certificate notices.
CADDY_OPTIONS=email you@example.org
# Optional: a "Source code" link on the home page.
SOURCE_URL=
# Optional: lobby limits (tools/signal defaults shown).
MAX_ROOMS=10000
MAX_CONNECTIONS=5000
MAX_CONNECTIONS_PER_ADDRESS=32
